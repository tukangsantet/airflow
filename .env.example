# Separate Architron DAG source repository. Relative paths are resolved from this
# installer directory; defaults match /workspace/airflow + /workspace/architron.
ARCHITRON_DAGS_SOURCE_PATH=../architron/airflow/dags
ARCHITRON_DAG_PACKAGE_SOURCE_PATH=../architron/airflow/architron_monitoring_airflow

# Airflow image/runtime
AIRFLOW_VERSION=2.11.2
PYTHON_VERSION=3.11
AIRFLOW_UID=50000
TZ=UTC

# Host-mounted runtime directories. Relative paths are resolved from this repo.
AIRFLOW_LOGS_PATH=./logs
POSTGRES_DATA_PATH=./data/postgres
REDIS_DATA_PATH=./data/redis
AIRFLOW_PLUGINS_PATH=./plugins
AIRFLOW_INCLUDE_PATH=./include

# Host exposure: Airflow listens on container port 8080, but is published on this host port.
AIRFLOW_BIND_ADDRESS=0.0.0.0
AIRFLOW_PORT=8090

# Celery parallelism. One worker runs this many tasks concurrently by default.
AIRFLOW_WORKER_CONCURRENCY=4
AIRFLOW_WORKER_REPLICAS=1
AIRFLOW_PARALLELISM=16
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=16

# Generate these values; do not commit a real .env file.
AIRFLOW_FERNET_KEY=GENERATE_WITH_bootstrap_script
AIRFLOW_SECRET_KEY=GENERATE_WITH_bootstrap_script

# Bootstrap admin account. Change after first login if required by policy.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=GENERATE_WITH_bootstrap_script
_AIRFLOW_WWW_USER_FIRSTNAME=Airflow
_AIRFLOW_WWW_USER_LASTNAME=Admin
_AIRFLOW_WWW_USER_EMAIL=airflow-admin@example.invalid

# Internal metadata database. It is not published to the host by default.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=GENERATE_WITH_bootstrap_script
POSTGRES_DB=airflow

# Internal Celery broker. Redis is not published to the host by default.
REDIS_PASSWORD=GENERATE_WITH_bootstrap_script
